                    IDC_STATIC,7,53,268,29
END

IDD_NAMEDLG DIALOG DISCARDABLE  0, 0, 186, 95
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Link Name"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,37,74,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,99,74,50,14
    EDITTEXT        IDC_NAME,25,44,135,14,ES_AUTOHSCROLL
