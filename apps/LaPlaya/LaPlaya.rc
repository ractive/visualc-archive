// English (U.S.) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)
#endif //_WIN32

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\LaPlaya.ico"
IDR_LAPLAYTYPE          ICON    DISCARDABLE     "res\\LaPlayaDoc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP  MOVEABLE PURE   "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR DISCARDABLE  16, 15
BEGIN
    BUTTON      ID_PREVIOUS
    BUTTON      ID_PLAY
    BUTTON      ID_PLAYCONT
    BUTTON      ID_NEXT
    BUTTON      ID_PAUSE
    BUTTON      ID_STOP
    BUTTON      ID_FULLSCREEN
    BUTTON      ID_HALFSIZE
    BUTTON      ID_ORIGSIZE
    BUTTON      ID_DOUBLESIZE
    BUTTON      ID_WINDOWFIT
    SEPARATOR
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "Settings...",                 ID_SETTINGS
        MENUITEM "Play continuous",             ID_PLAYCONT
        MENUITEM "Play",                        ID_PLAY
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About LaPlaya...",           ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS PRELOAD MOVEABLE PURE 
BEGIN
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "S",            ID_STOP,                VIRTKEY, NOINVERT
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT, NOINVERT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT, NOINVERT
    VK_LEFT,        ID_PREVIOUS,            VIRTKEY, NOINVERT
    VK_RETURN,      ID_PLAY,                VIRTKEY, NOINVERT
    VK_RIGHT,       ID_NEXT,                VIRTKEY, NOINVERT
    VK_SPACE,       ID_PAUSE,               VIRTKEY, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 261, 101
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About LaPlaya"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    DEFPUSHBUTTON   "OK",IDOK,204,7,50,14,WS_GROUP
    LTEXT           "LaPlaya Version 1.1\r\n12. June 2001",IDC_STATIC,46,7,
                    132,21,SS_NOPREFIX
    LTEXT           "(c) by Jean-Pierre Bergamin",IDC_MAIL,46,29,137,8
    LTEXT           "For further updates, please visit:",IDC_STATIC,46,62,
                    101,8
    LTEXT           "http://www.ractive.ch/gpl/laplaya.html",IDC_HOMEPAGE,46,
                    74,124,8
    LTEXT           "This software is licensed under the GPL",IDC_STATIC,46,
                    49,129,8
    LTEXT           "mailto:james@ractive.ch",IDC_EMAIL,46,40,78,8
    PUSHBUTTON      "Keyboard",IDC_KEYS,204,31,50,14
END

IDR_MAINFRAME DIALOG DISCARDABLE  0, 0, 330, 16
STYLE WS_CHILD
FONT 8, "MS Sans Serif"
BEGIN
END

IDD_LISTTOOLBAR DIALOG DISCARDABLE  0, 0, 148, 29
STYLE WS_CHILD
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "AVI",IDC_AVI,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,2,2,
                    27,10
    CONTROL         "MPEG",IDC_MPG,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,33,
                    2,37,10
    CONTROL         "MOV",IDC_MOV,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,74,2,
                    32,10
    CONTROL         "Others",IDC_REST,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,
                    110,2,37,10
    LTEXT           "Custom filter:",IDC_STATIC,2,18,41,8
    EDITTEXT        IDC_FILTER,49,16,69,13,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Apply",IDC_APPLYFILTER,123,16,22,13
END

IDD_SETTINGS DIALOG DISCARDABLE  0, 0, 148, 93
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,12,67,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,84,67,50,14
    CONTROL         "Show controls in player frame",IDC_SHOWCONTROLS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,11,10,108,10
    CONTROL         "Allow resizing of clips",IDC_AUTORESIZE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,11,27,82,10
    CONTROL         "Start clips automatically",IDC_AUTOSTART,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,11,44,89,10
    GROUPBOX        "",IDC_STATIC,7,0,134,61
END

IDD_KEYDLG DIALOG DISCARDABLE  0, 0, 149, 103
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Key settings"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,50,83,50,14
    LTEXT           "Use the keyboard to control the player:",IDC_STATIC,13,
                    11,123,8
    LTEXT           "Previous clip\r\nNext clip\r\nPlay\r\nPause\r\nStop",
                    IDC_STATIC,77,31,42,43
    LTEXT           "Left arrow:\r\nRight arrow:\r\nEnter:\r\nSpace:\r\nS:",
                    IDC_STATIC,29,31,42,43
    GROUPBOX        "",IDC_STATIC,4,0,141,79
END


