    PUSHBUTTON      "Cancel",IDCANCEL,121,115,50,14
    LTEXT           "Username:",IDC_STATIC,19,32,35,8
    LTEXT           "Password:",IDC_STATIC,19,48,34,8
    LTEXT           "E-Mail:",IDC_STATIC,19,81,22,8
    LTEXT           "This will create a new account at www.myip.org",
