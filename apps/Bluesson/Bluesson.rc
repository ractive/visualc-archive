/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 256, 167
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Bluesson"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,21,20
    LTEXT           "Bluesson Version 0.9",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002 by\r\nJean-Pierre Bergamin",
                    IDC_STATIC,40,25,119,19
    DEFPUSHBUTTON   "OK",IDOK,199,7,50,14,WS_GROUP
    LTEXT           "Copyright (C) June 2002 by Jean-Pierre Bergamin\r\n\r\nThis program is free software; you can redistribute it and/or\r\nmodify it under the terms of the GNU General Public License\r\nas published by the Free Software Foundation; either version 2",
                    IDC_STATIC,40,43,209,44
    LTEXT           "of the License, or (at your option) any later version.\r\n\r\nThis program is distributed in the hope that it will be useful,\r\nbut WITHOUT ANY WARRANTY; without even the implied warranty of\r\nMERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.",
                    IDC_STATIC,40,86,200,59
    LTEXT           "See the GNU General Public License for more details.",
                    IDC_STATIC,40,145,197,13
END

IDD_BLUESSON_DIALOG DIALOGEX 0, 0, 214, 45
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Ericsson WinAmp RC"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    COMBOBOX        IDC_COMPORT,52,7,54,72,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "COM-Port:",IDC_STATIC,7,9,34,8
    LTEXT           "Winamp-Exe:",IDC_STATIC,7,27,43,8
    GROUPBOX        "",IDC_STATIC,2,0,210,42
    EDITTEXT        IDC_WINAMPEXE,53,24,137,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_GETWINAMPEXE,193,24,14,14
    PUSHBUTTON      "Reset",IDC_TEST,157,7,50,10
END


