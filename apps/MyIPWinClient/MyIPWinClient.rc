    EDITTEXT        IDC_PASSWORD,71,46,123,12,ES_PASSWORD | ES_AUTOHSCROLL
    EDITTEXT        IDC_PASSWORD2,71,62,123,12,ES_PASSWORD | ES_AUTOHSCROLL
