IDR_MAINFRAME MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New",                        IDC_NEW
        MENUITEM "&Open...",                    IDC_OPEN
        MENUITEM "&Save",                       IDC_SAVE
        MENUITEM "Save &as...",                 IDC_SAVEAS
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "Melody"
    BEGIN
        MENUITEM "&Play",                       IDC_PLAY
        MENUITEM "&Stop",                       IDC_STOP
        MENUITEM SEPARATOR
        MENUITEM "&Clear Melody",               IDC_CLEAR
    END
    POPUP "Help"
    BEGIN
        MENUITEM "&About...",                   ID_HELP
        MENUITEM "&Links...",                   ID_LINKS
    END
END


