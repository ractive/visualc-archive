IDI_FTPICON             ICON    DISCARDABLE     "res\\ftp.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ADDDIALOG DIALOG DISCARDABLE  0, 0, 425, 242
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add synchronisation pair"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_LOCALFOLDER,15,19,177,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_CHOOSELOCAL,195,19,16,14
    CONTROL         "Include subdirectories",IDC_INCLUDESUBDIRS,"Button",
                    BS_AUTOCHECKBOX | NOT WS_VISIBLE | WS_TABSTOP,15,37,85,
                    10
    EDITTEXT        IDC_FTPSERVER,56,68,154,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_PORT,55,86,40,14,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_FTPDIRECTORY,56,105,154,14,ES_AUTOHSCROLL
    CONTROL         "Login anonymously",IDC_ANONYMOUS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,15,152,76,10
    EDITTEXT        IDC_USERNAME,58,164,151,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_PASSWORD,58,185,151,14,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "Update local and remote files: File up- and downloads",
                    IDC_SYNCTWOWAY,"Button",BS_AUTORADIOBUTTON | WS_GROUP,
                    235,17,181,10
    CONTROL         "Update files on the FTP-server  (=> only uploads)",
                    IDC_SYNCFTP,"Button",BS_AUTORADIOBUTTON | BS_TOP | 
                    BS_MULTILINE,235,31,181,10
    CONTROL         "Update local files   (=> only downloads)",IDC_SYNCLOCAL,
                    "Button",BS_AUTORADIOBUTTON | BS_TOP | BS_MULTILINE,235,
                    45,181,10
    CONTROL         "Always overwrite local files",IDC_ALWAYSOVERWRITELOCAL,
                    "Button",BS_AUTORADIOBUTTON | WS_GROUP,235,82,177,10
    CONTROL         "Ask before overwriting local file",
                    IDC_ASKOVERWRITELOCAL,"Button",BS_AUTORADIOBUTTON,235,95,
                    177,10
    CONTROL         "Always overwrite files on FTP-server",
                    IDC_ALWAYSOVERWRITEFTP,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP,235,123,177,10
    CONTROL         "Ask before overwriting files on FTP-server",
                    IDC_ASKOVERWRITEFTP,"Button",BS_AUTORADIOBUTTON,235,137,
                    177,10
    CONTROL         "Ask which file-version should be transferred",
                    IDC_CONFLICTASK,"Button",BS_AUTORADIOBUTTON | WS_GROUP,
                    235,166,177,10
    CONTROL         "Replace file on FTP-server  (=> upload)",
                    IDC_CONFLICTUPLOAD,"Button",BS_AUTORADIOBUTTON,235,179,
                    177,10
    CONTROL         "Replace local file (=> download)",IDC_CONFLICTDOWNLOAD,
                    "Button",BS_AUTORADIOBUTTON,235,193,177,10
    DEFPUSHBUTTON   "OK",IDOK,7,221,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,368,221,50,14
    GROUPBOX        "Local Folder: ",IDC_STATIC,7,7,209,45
    CONTROL         "Passive mode (if behind Firewall or Router)",
                    IDC_PASSIVEMODE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,15,
                    123,149,10
    LTEXT           "Server:",IDC_STATIC,15,70,24,8
    LTEXT           "Directory:",IDC_STATIC,15,107,31,8
    LTEXT           "Port:",IDC_STATIC,15,88,16,8
    LTEXT           "Username:",IDC_STATIC,15,167,35,8
    LTEXT           "Password:",IDC_STATIC,15,186,34,8
    GROUPBOX        "FTP location: ",IDC_STATIC,7,53,209,84
    GROUPBOX        "Login information: ",IDC_STATIC,7,138,209,73
    GROUPBOX        "",IDC_STATIC,3,0,218,216
    GROUPBOX        "",IDC_STATIC,224,0,199,216
    GROUPBOX        "Synchronisation direction: ",IDC_STATIC,228,7,193,53
    GROUPBOX        "Confirmation: ",IDC_STATIC,227,62,193,150
    GROUPBOX        "Local files: ",IDC_STATIC,231,70,187,40
    GROUPBOX        "Remote files: ",IDC_STATIC,231,112,187,40
    GROUPBOX        "On conflicts: ",IDC_STATIC,231,155,187,52
END

IDD_FIRSTSYNCDLG DIALOG DISCARDABLE  0, 0, 232, 95
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "First synchronisation"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,44,74,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,137,74,50,14
    LTEXT           "This is the first synchronisation of the two directories",
                    IDC_STATIC,7,7,164,8
    GROUPBOX        "Would you like to: ",IDC_STATIC,7,21,218,44
    CONTROL         "Replace the files on the FTP server with the local files?",
                    IDC_REPLACEFTP,"Button",BS_AUTORADIOBUTTON,16,32,189,10
    CONTROL         "Replace the local files with the files on the FTP server?",
                    IDC_REPLACELOCAL,"Button",BS_AUTORADIOBUTTON,16,46,189,
                    10
END

IDD_CONFLICTDLG DIALOGEX 0, 0, 260, 114
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Konflikt"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Upload the local file to the FTP-server and replace it",
                    IDC_CONFLICTUPLOAD,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP,13,50,179,10
    CONTROL         "Download the file from the FTP-server and replace the local one",
                    IDC_CONFLICTDOWNLOAD,"Button",BS_AUTORADIOBUTTON,13,66,
                    217,10
    DEFPUSHBUTTON   "OK",IDOK,47,93,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,162,93,50,14
    LTEXT           "The following file has been changed on both locations:",
                    IDC_STATIC,7,7,173,8
    GROUPBOX        "Which version to you want to keep: ",IDC_STATIC,7,38,
                    246,43
    LTEXT           "Static",IDC_FILE,7,19,246,13,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
END

IDD_SYNCPROGRESSDLG DIALOGEX 0, 0, 211, 124
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Synchronising"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,80,103,50,14
    LTEXT           "Uploading:",IDC_STATIC,7,30,35,8
    CONTROL         "Progress1",IDC_UPLOADPROGRESS,"msctls_progress32",
                    WS_BORDER,7,46,197,11
    LTEXT           "",IDC_UPLOADFILE,51,30,152,11,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
    LTEXT           "Downloading:",IDC_STATIC,7,68,44,8
    CONTROL         "Progress1",IDC_DOWNLOADPROGRESS,"msctls_progress32",
                    WS_BORDER,7,84,197,11
    LTEXT           "",IDC_DOWNLOADFILE,51,68,152,11,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
    LTEXT           "",IDC_OVERALL,7,7,197,11,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
END


