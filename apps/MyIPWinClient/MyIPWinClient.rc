IDD_SETTINGS DIALOGEX 0, 0, 258, 212
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         "Store user name",IDC_STOREUSER,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,16,16,70,10
    CONTROL         "Store password",IDC_STOREPASS,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,106,16,70,10
    CONTROL         "Minimize at startup",IDC_MINIMIZE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,30,74,10
    CONTROL         "Add to tray",IDC_ADDTOTRAY,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,106,30,50,10
    CONTROL         "Use Port 18080",IDC_PORT18080,"Button",BS_AUTOCHECKBOX | 
                    WS_DISABLED | WS_TABSTOP,107,59,65,10
    CONTROL         "Update automatically when connection is detected",
                    IDC_AUTOUPDATE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,
                    102,175,10
    CONTROL         "I'm connected via Modem/ISDN",IDC_MODEMCONN,"Button",
                    BS_AUTORADIOBUTTON,24,127,118,10
    CONTROL         "I'm connected via LAN (or otherwise)",IDC_LANCONN,
                    "Button",BS_AUTORADIOBUTTON,24,151,182,10
    DEFPUSHBUTTON   "OK",IDOK,56,191,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,150,191,50,14
    GROUPBOX        "General settings ",IDC_STATIC,7,3,242,74,0,
                    WS_EX_DLGMODALFRAME
    GROUPBOX        "Auto update",IDC_STATIC,7,86,244,97,0,
                    WS_EX_DLGMODALFRAME
    LTEXT           "(using the default Dial-Up Network of Windows)",
                    IDC_MODEMTEXT,35,139,175,8
    LTEXT           "(NOT using the default Dial-Up Network of Windows)",
                    IDC_LANTEXT,36,163,175,8
    GROUPBOX        "Connection type",IDC_CONNECTIONTYPE,16,118,224,59
    CONTROL         "Always send local IP",IDC_ALWGETIP,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,44,81,10
    CONTROL         "Warn when no change",IDC_WARN,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,106,44,118,10
END

IDD_ABOUTDLG DIALOG DISCARDABLE  0, 0, 192, 102
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,135,81,50,14
    LTEXT           "Windows client for",IDC_STATIC,7,7,67,10
    LTEXT           "Version 3.41\r\n13. August 2001",IDC_STATIC,7,20,91,19
    ICON            IDR_MAINFRAME,IDC_STATIC,155,17,20,20
    LTEXT           "(c) by Jean-Pierre Bergamin\nmyipwinclient@ractive.ch\r\nThis software is licensed under the GPL",
                    IDC_MAIL,7,44,135,27
    LTEXT           "For further updates, please visit:",IDC_STATIC,7,76,101,
                    8
    LTEXT           "http://myipclient.cjb.net",IDC_MYIPCLIENT,7,87,76,8
    LTEXT           "www.myip.org",IDC_MYIPORG,72,7,45,8
END

IDD_MXTIPS DIALOG DISCARDABLE  0, 0, 221, 159
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Tips for the MX-Record"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,83,138,50,14
    LTEXT           "Using the MX-Record:",IDC_STATIC,14,7,71,8
    LTEXT           "You can use the MX-Record to forward mail to the machine xyz.myip.org.\nYou must be able to configure this machine so that It accepts mail for the domain myip.org.\n\nAn Example:",
                    IDC_STATIC,14,22,191,52
    LTEXT           "If you put myip.org in the MX-Record, all mail that is sent to name@xyz.myip.org is then ""forwarded"" to the mail-box of the user ""name"" on the machine xzy.myip.org and can be read like any other mail.",
                    IDC_STATIC,14,74,191,37
    LTEXT           "This way you can send me i.e. mail to mail@james.myip.org",
                    IDC_STATIC,14,112,186,8
    GROUPBOX        "",IDC_STATIC,7,0,207,128
END


