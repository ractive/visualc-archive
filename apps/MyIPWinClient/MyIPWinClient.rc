IDR_TRAY MENU DISCARDABLE 
BEGIN
    POPUP "TrayMenu"
    BEGIN
        MENUITEM "&Restore",                    ID_RESTORE
        MENUITEM "&Update Account",             IDC_UPDATE
        MENUITEM "&Exit",                       ID_EXIT
        MENUITEM "&About...",                   ID_ABOUT
    END
END

IDR_MAINMENU MENU DISCARDABLE 
BEGIN
    POPUP "&Action"
    BEGIN
        MENUITEM "&Update Host",                IDC_UPDATE
        MENUITEM "Advanded Update...",          ID_ADVUPDATE
        MENUITEM "Manage your hosts...",        IDC_HOSTBUTTON
        MENUITEM "Change your password...",     IDC_PASSBUTTON
        MENUITEM SEPARATOR
        MENUITEM "&Create new account...",      ID_CREATENEW
        MENUITEM "&Delete account...",          ID_DELETEACC
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_EXIT
    END
    MENUITEM "&Settings",                   ID_SETTINGS
    MENUITEM "About...",                    ID_ABOUT
END


