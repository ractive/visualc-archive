/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 63
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NTMessenger"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,21,20
    LTEXT           "NTMessenger Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2000 by J.P. Bergamin\r\nFor updates plese visit http://www.ractive.ch/gpl",
                    IDC_STATIC,40,26,119,30
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_NTMESSENGER_DIALOG DIALOGEX 0, 0, 218, 114
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "NTMessenger"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_MESSAGETEXT,53,55,156,53,ES_MULTILINE | 
                    ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "&Send",IDC_SEND,10,55,36,16,BS_ICON | BS_FLAT
    PUSHBUTTON      "&Preferences...",IDC_OPTIONS,10,73,36,16,BS_ICON | 
                    BS_FLAT
    PUSHBUTTON      "&Clear",IDC_CLEAR,10,91,36,16,BS_ICON | BS_FLAT
    EDITTEXT        IDC_NAME,53,10,156,12,ES_AUTOHSCROLL
    COMBOBOX        IDC_SERVERCOMBO,53,29,156,80,CBS_DROPDOWN | 
                    CBS_AUTOHSCROLL | CBS_DISABLENOSCROLL | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "From:",IDC_STATIC,10,11,35,8
    PUSHBUTTON      "To:",IDC_MULTIPLE,10,29,36,12,BS_FLAT
    GROUPBOX        "",IDC_STATIC,4,46,210,66
    GROUPBOX        "",IDC_STATIC,4,1,210,46
END


