/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 55
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NetConfigurator"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "NetConfigurator Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2002 by J.P. Bergamin\r\nhttp://www.ractive.ch/gpl/netconfigurator.html",
                    IDC_STATIC,40,25,172,23
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
END

IDD_NETCONFIGURATOR_DIALOG DIALOGEX 0, 0, 228, 52
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "NetConfigurator"
FONT 8, "MS Sans Serif"
BEGIN
    COMBOBOX        IDC_SETTINGSCOMBO,86,7,130,141,CBS_DROPDOWNLIST | 
                    CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Network configurations:",IDC_STATIC,7,9,76,8
    PUSHBUTTON      "Add...",IDC_ADD,7,27,39,14
    PUSHBUTTON      "Modify...",IDC_MODIFY,63,27,39,14
    PUSHBUTTON      "Delete",IDC_DELETE,119,27,39,14
    GROUPBOX        "",IDC_STATIC,4,0,217,45
    PUSHBUTTON      "Apply",IDC_APPLY,175,27,39,14
END

IDD_NETWORKCONFIG DIALOG DISCARDABLE  0, 0, 235, 201
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "IP configuration"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL         "Obtain an IP address &automatically",IDC_DHCPIP,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,15,9,125,10
    CONTROL         "Use the following IP address:",IDC_STATICIP,"Button",
                    BS_AUTORADIOBUTTON,15,20,107,10
    CONTROL         "IPAddress1",IDC_IPADDRESS,"SysIPAddress32",WS_TABSTOP,
                    118,33,100,15
    CONTROL         "IPAddress2",IDC_SUBNETMASK,"SysIPAddress32",WS_TABSTOP,
                    118,52,100,15
    CONTROL         "IPAddress3",IDC_GATEWAY,"SysIPAddress32",WS_TABSTOP,118,
                    71,100,15
    CONTROL         "Get DNS-Settings automatically",IDC_DHCPDNS,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP,15,103,115,10
    CONTROL         "Use the following DNS-settings:",IDC_MANUALDNS,"Button",
                    BS_AUTORADIOBUTTON,15,116,115,10
    CONTROL         "IPAddress2",IDC_DNS1,"SysIPAddress32",WS_TABSTOP,118,
                    129,100,15
    CONTROL         "IPAddress3",IDC_DNS2,"SysIPAddress32",WS_TABSTOP,118,
                    148,100,15
    DEFPUSHBUTTON   "OK",IDOK,107,180,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,178,180,50,14
    GROUPBOX        "",IDC_STATIC,7,3,221,90
    LTEXT           "IP-address:",IDC_STATIC,17,36,36,8
    LTEXT           "Subnet Mask:",IDC_STATIC,17,57,45,8
    LTEXT           "Standard gateway:",IDC_STATIC,17,76,60,8
    GROUPBOX        "",IDC_STATIC,7,95,221,73
    LTEXT           "Primary DNS server:",IDC_STATIC,17,133,64,8
    LTEXT           "Secondary DNS server:",IDC_STATIC,17,151,76,8
    GROUPBOX        "",IDC_STATIC,3,0,230,199
END

IDD_CONFIGNAME DIALOG DISCARDABLE  0, 0, 140, 57
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuration name"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_NAME,7,17,126,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,7,36,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,81,36,50,14
    LTEXT           "Configuration Name:",IDC_STATIC,7,7,65,8
END


