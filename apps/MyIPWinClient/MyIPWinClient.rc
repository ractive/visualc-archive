    CONTROL         132,IDC_MYIPLOGO,"Static",SS_BITMAP,223,3,53,11
    PUSHBUTTON      "&Configuration...",ID_SETTINGS,208,52,68,14
    LTEXT           "www.myip.org",IDC_MYIPORG,222,71,45,8
    COMBOBOX        IDC_HOSTS,67,42,123,61,CBS_DROPDOWNLIST | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Hosts:",IDC_HOSTBUTTON,14,42,45,12,BS_LEFT | BS_FLAT
    PUSHBUTTON      "Password:",IDC_PASSBUTTON,13,26,45,12,BS_LEFT | BS_FLAT
