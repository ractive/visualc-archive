IDD_WELCOME DIALOG DISCARDABLE  0, 0, 210, 129
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Welcome to the MyIPWinClient"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "This is the first time you started the MyIPWinClient.",
                    IDC_STATIC,7,16,159,8
    LTEXT           "The MyIPWinClient let's you easily create and update your account at",
                    IDC_STATIC,7,30,196,17
    LTEXT           "http://www.myip.org",IDC_MYIP,7,50,66,8
    LTEXT           "What would you like to do:",IDC_STATIC,7,65,85,8
    PUSHBUTTON      "Create a new account...",IDOK,24,78,161,14,BS_LEFT | 
                    BS_FLAT
    PUSHBUTTON      "Let me in, I already have an account...",IDCANCEL,24,99,
                    161,14,BS_LEFT | BS_FLAT
END

