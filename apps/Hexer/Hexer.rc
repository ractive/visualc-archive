/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 208, 82
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Hexer"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,7,33,20,20
    LTEXT           "Hexer Version 2.0",IDC_STATIC,40,10,84,8,SS_NOPREFIX
    LTEXT           "(C) by Jean-Pierre Bergamin\r\n25. June 2001\r\n\r\nFor the source code and more information\r\nplease visit http://www.ractive.ch/gpl/hexer.html",
                    IDC_STATIC,39,22,151,54
    DEFPUSHBUTTON   "OK",IDOK,151,7,50,14,WS_GROUP
END

IDD_HEXER_DIALOG DIALOGEX 0, 0, 169, 127
STYLE WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Hexer"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_DECIMAL,42,7,120,14,ES_RIGHT | ES_AUTOHSCROLL | 
                    ES_NUMBER
    EDITTEXT        IDC_SIGNED,42,23,120,14,ES_RIGHT | ES_AUTOHSCROLL
    EDITTEXT        IDC_HEX,70,38,92,14,ES_RIGHT | ES_AUTOHSCROLL
    EDITTEXT        IDC_OCTAL,42,54,120,14,ES_RIGHT | ES_AUTOHSCROLL
    EDITTEXT        IDC_BINARY,42,70,120,14,ES_RIGHT | ES_AUTOHSCROLL
    EDITTEXT        IDC_DOUBLE,74,87,88,14,ES_RIGHT | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Calculate",ID_CALCULATE,81,109,69,13
    CONTROL         "Spin1",IDC_SPIN,"msctls_updown32",UDS_ARROWKEYS | 
                    WS_TABSTOP,154,109,8,13
    LTEXT           "Hex:",IDC_STATIC,5,41,16,8
    LTEXT           "Unsigned:",IDC_STATIC,5,10,33,8
    LTEXT           "Octal:",IDC_STATIC,5,57,20,8
    LTEXT           "Binary:",IDC_STATIC,5,73,22,8
    LTEXT           "Double:",IDC_STATIC,5,90,26,8
    LTEXT           "Signed:",IDC_STATIC,5,26,25,8
    CONTROL         "",IDC_COLORBUTTON,"Button",BS_OWNERDRAW | BS_FLAT | 
                    WS_TABSTOP,42,38,25,14
    CONTROL         "On top",IDC_ALWAYSONTOP,"Button",BS_AUTOCHECKBOX | 
                    BS_ICON | BS_PUSHLIKE | WS_TABSTOP,5,109,14,13
    COMBOBOX        IDC_BITCOMBO,42,109,37,59,CBS_DROPDOWN | WS_VSCROLL | 
                    WS_TABSTOP
    EDITTEXT        IDC_PRECISION,42,87,16,14,ES_AUTOHSCROLL
    GROUPBOX        "",IDC_STATIC,2,0,165,105
    GROUPBOX        "",IDC_STATIC,2,102,165,23
END


