IDD_MULTIPLEDLG DIALOG DISCARDABLE  0, 0, 214, 146
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose the recipients..."
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,43,125,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,121,125,50,14
    LISTBOX         IDC_RECIPIENTS,121,26,86,83,LBS_SORT | LBS_MULTIPLESEL | 
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LISTBOX         IDC_SERVERS,7,26,86,83,LBS_SORT | LBS_MULTIPLESEL | 
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Available servers:",IDC_STATIC,7,13,56,8
    LTEXT           "Recipients:",IDC_STATIC,121,13,36,8
    PUSHBUTTON      "-->",IDC_ADD,98,51,17,14,BS_CENTER | BS_VCENTER
    PUSHBUTTON      "<--",IDC_REMOVE,98,71,17,14,BS_CENTER | BS_VCENTER
END

IDD_OPTIONSDLG DIALOG DISCARDABLE  0, 0, 158, 191
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preferences..."
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,20,170,50,14
    CONTROL         "Start minimized",IDC_STARTMINIMIZED,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,7,63,10
    CONTROL         "Delete message when sent",IDC_DELETEWHENSENT,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,22,101,10
    CONTROL         "Rescan network every",IDC_RESCAN,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,7,38,87,10
    EDITTEXT        IDC_MINUTES,101,36,28,14,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Spin1",IDC_SPIN1,"msctls_updown32",UDS_SETBUDDYINT | 
                    UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,130,18,11,
                    14
    LTEXT           "min.",IDC_STATIC,134,40,14,8
    PUSHBUTTON      "Cancel",IDCANCEL,87,170,50,14
    LTEXT           "Domain Controller",IDC_STATIC,7,88,56,8
    EDITTEXT        IDC_PDC,67,85,76,14,ES_AUTOHSCROLL
    LTEXT           "Domain to scan",IDC_STATIC,7,106,50,8
    EDITTEXT        IDC_DOMAIN,67,103,76,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Rescan Network now!",IDC_RESCANNOW,32,57,94,14
    GROUPBOX        "Computers that will be shown",IDC_STATIC,7,124,140,41
    CONTROL         "Only Workstations",IDC_ONLYWORKSTATIONS,"Button",
                    BS_AUTORADIOBUTTON,14,136,118,10
    CONTROL         "All Computers",IDC_ALLPCS,"Button",BS_AUTORADIOBUTTON,
                    14,150,59,10
END


