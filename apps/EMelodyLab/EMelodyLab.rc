// German (Germany) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_DEU)
#ifdef _WIN32
LANGUAGE LANG_GERMAN, SUBLANG_GERMAN
#pragma code_page(1252)
#endif //_WIN32

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 420, 295
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Info über EMelodyLab"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,10,20,20
    LTEXT           "EMelodyLab Version 1.3",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2001 by J.P. Bergamin",IDC_STATIC,40,22,
                    119,8
    DEFPUSHBUTTON   "OK",IDOK,362,9,50,14,WS_GROUP
    LTEXT           "What's that:\r\n================\r\nUse this program to compose your EMELODY ringtone! The produced rintones are EMS standard,\r\nbut (as far as I know) only supported by Ericsson phones at the moment!\r\n\r\nCompose your ringtone and save it!",
                    IDC_STATIC,7,53,406,51
    LTEXT           " Open Windows-Explorer, right-click on the file and choose\r\n""Send to - Infrared receiver"". The ringtone should be transferred to your phone!\r\n\r\nAbout the program:\r\n================\r\nValid tones are:",
                    IDC_STATIC,7,106,406,49
    LTEXT           "Uppercase letters mean a long tone (i.e. #C). A point after a tone makes it longer\r\n A ""+"" in front of a tone means one octave higher, ""++"" two octaves  (i.e. ""+(b)E"")\r\nUse ""p"" for a pause.\r\nFor a detailed description see:",
                    IDC_STATIC,7,182,406,35
    LTEXT           "http://www.mobileems.com/ems2.pdf",IDC_WHITEPAPERURL,7,
                    219,406,8
    LTEXT           "If you hit ""Play"", the tone starts playing at the current cursor position!!!! Select a part to only play this part!\r\n\r\nIf you check ""Play when changing cursor"" you hear any subsequent tone if you use the right-arrow to move the\r\ncursor within the melody.",
                    IDC_STATIC,7,232,406,34
    LTEXT           "If you have questions or other ideas, write me to:",
                    IDC_STATIC,7,267,153,8
    LTEXT           "mailto:james@ractive.ch",IDC_MAIL,7,279,78,8
    LTEXT           "http://www.ractive.ch/gpl/EMelodyLab.html",IDC_URL,40,
                    33,141,8
    GROUPBOX        "",IDC_STATIC,2,0,416,291
    LTEXT           "c d e f g a b\r\n(b)d (b)e (b)g (b)a (b)b\r\n#d #e #g #a #b",
                    IDC_STATIC,7,154,184,25
END

IDD_EMELODYLAB_DIALOG DIALOGEX 0, 0, 320, 106
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "EMelodyLab"
MENU IDR_MAINFRAME
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_MELODY,36,10,277,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_SPEED,36,45,40,14,ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Play",IDC_PLAY,209,45,50,14
    PUSHBUTTON      "Stop",IDC_STOP,263,45,50,14,WS_DISABLED
    PUSHBUTTON      "Open...",IDC_OPEN,7,73,50,14
    PUSHBUTTON      "Save",IDC_SAVE,67,73,50,14
    PUSHBUTTON      "Close",IDOK,263,73,50,14
    LTEXT           "Melody:",IDC_STATIC,7,12,26,8
    LTEXT           "Speed:",IDC_STATIC,7,49,24,8
    LTEXT           "Beats per minute",IDC_STATIC,80,49,54,8
    LTEXT           "",IDC_AVAILABLE,158,29,155,12,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
    GROUPBOX        "",IDC_STATIC,3,0,314,65
    CONTROL         "Play when changing cursor (->)",IDC_PLAYRIGHT,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,36,28,113,10
    CONTROL         "Loop",IDC_LOOP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,
                    158,47,32,10
    ICON            IDR_MAINFRAME,IDC_STATIC,7,26,20,20
    GROUPBOX        "",IDC_STATIC,3,66,314,25
    PUSHBUTTON      "<",IDC_REWIND,193,45,12,14
    LTEXT           "Please upload your ringtones to:",IDC_STATIC,7,94,102,8
    LTEXT           "http://www.ractive.ch/t68/ringtones.php",IDC_UPLOADURL,
                    114,94,199,8
END


